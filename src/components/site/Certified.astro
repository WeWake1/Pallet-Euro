---
// "Certified at every step." The certificate list the owner kept (decision #15). Every number is still a placeholder
// (src/data/certificates.ts): at launch, list only certificates issued to Pallet Euro Packaging itself, each with its
// number, issuer, valid-until date and a Verify link (CLAUDE.md, hard rule 3).
import Icon from './Icon.astro';
import { CERTS } from '../../data/certificates';
---
<section class="certs" id="certified" aria-labelledby="certs-title">
  <div class="c-copy">
    <h2 class="h2" id="certs-title">Certified at every step.</h2>
    <p>Every certificate here links to the register of the body that issued it. Check us before you place an order.</p>
    <a class="more" href="/certifications/">All certificates <Icon name="arrow-right" size={18} /></a>
  </div>
  <ul class="rows">
    {CERTS.map((c, i) => (
      <li data-reveal style={`transition-delay:${i * 50}ms`}>
        <Icon name={c.icon} size={30} />
        <div class="r-main"><b>{c.name}</b><span>{c.issuer}</span></div>
        <div class="r-num"><span>No.</span><mark>{c.number}</mark></div>
        {c.verifyUrl ? (
          <a class="r-verify" href={c.verifyUrl} rel="noopener" aria-label={`Verify the ${c.name} on ${c.verifyLabel ?? 'the issuer’s register'}`}>Verify <Icon name="arrow-up-right" size={16} /></a>
        ) : (
          <span class="r-verify muted">On request</span>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .certs { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; padding: 120px var(--pad) 140px; background: var(--mist); }
  .c-copy { position: sticky; top: 120px; align-self: start; }
  .c-copy p { margin: 20px 0 22px; font-size: 18px; line-height: 1.6; color: var(--ink-2); max-width: 28em; }
  .rows li { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto auto; gap: 22px; align-items: center; padding: 24px 4px; border-bottom: 1px solid #dde3ec; transition: background 0.3s, opacity 0.9s var(--ease), transform 0.9s var(--ease); }
  .rows li:first-child { border-top: 1px solid #dde3ec; }
  .rows li:hover { background: rgba(255, 255, 255, 0.7); }
  .rows li > :global(svg) { color: var(--blue); }
  .r-main { display: flex; flex-direction: column; gap: 3px; }
  .r-main b { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }
  .r-main span { font-size: 15px; color: var(--ink-3); }
  .r-num { display: flex; gap: 8px; align-items: baseline; font-size: 16px; font-weight: 650; white-space: nowrap; }
  .r-num span { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .r-verify { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 16px; border-radius: 999px; font-size: 15px; font-weight: 650; color: var(--blue); background: #fff; box-shadow: inset 0 0 0 1px #d9e2f5; text-decoration: none; transition: background 0.25s; }
  .r-verify:hover { background: var(--blue-soft); }
  .r-verify.muted { background: none; box-shadow: none; color: var(--ink-3); }
  @media (max-width: 1100px) {
    .certs { grid-template-columns: minmax(0, 1fr); gap: 40px; padding: 96px var(--pad); }
    .c-copy { position: static; }
  }
  @media (max-width: 640px) {
    .rows li { grid-template-columns: 30px minmax(0, 1fr); gap: 8px 16px; }
    .r-num, .r-verify { grid-column: 2; justify-self: start; }
  }
</style>
