---
// Phosphor icon (light weight), inlined at build time.
interface Props { name: string; class?: string; size?: number }
const { name, class: cls = '', size = 24 } = Astro.props;
const all = import.meta.glob('/node_modules/@phosphor-icons/core/assets/light/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const svg = all[`/node_modules/@phosphor-icons/core/assets/light/${name}-light.svg`];
if (!svg) throw new Error(`Unknown icon: ${name}`);
const html = svg.replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="${cls}" `);
---
<Fragment set:html={html} />
