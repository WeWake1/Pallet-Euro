---
// "Your next container, on EPAL pallets." The deep-blue quote band the owner kept (decision #15); the container
// scroll story (decision #24) will end on it.
import Icon from './Icon.astro';
import { QUOTE_HREF, whatsappHref } from '../../data/site';
---
<section class="band" id="quote" aria-labelledby="quote-title">
  <h2 id="quote-title" data-reveal>Your next container,<br />on EPAL pallets.</h2>
  <div class="actions" data-reveal>
    <a class="btn white" href={QUOTE_HREF}>Request a quotation</a>
    <a class="btn ghost" href={whatsappHref()}><Icon name="whatsapp-logo" size={18} />WhatsApp</a>
  </div>
</section>

<style>
  .band { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; padding: 100px var(--pad); background: var(--blue); color: #fff; }
  h2 { font-family: var(--condensed); font-weight: 850; text-transform: uppercase; font-size: clamp(42px, 4.8vw, 76px); line-height: 0.92; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .actions :global(.btn) { font-family: var(--condensed); font-size: 18px; font-weight: 750; letter-spacing: 0.02em; height: 54px; padding: 0 28px; }
  @media (max-width: 1100px) { .band { padding: 72px var(--pad); } }
</style>
