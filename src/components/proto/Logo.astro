---
// Temporary wordmark until the real logo exists: "PALLET EURO" large, "packaging" small,
// with a pallet side-view glyph. Typeface comes from the surrounding variant (font-family: inherit).
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = '' } = Astro.props;
---
<a class:list={['logo', tone, cls]} href="#" aria-label="Pallet Euro Packaging, home">
  <svg class="glyph" viewBox="0 0 32 22" aria-hidden="true">
    <rect x="0" y="0" width="32" height="4.4" rx="1.2" />
    <rect x="1.6" y="6.4" width="6.6" height="8" rx="1" />
    <rect x="12.7" y="6.4" width="6.6" height="8" rx="1" />
    <rect x="23.8" y="6.4" width="6.6" height="8" rx="1" />
    <rect x="0" y="16.6" width="32" height="4.4" rx="1.2" />
  </svg>
  <span class="words"><b>PALLET EURO</b><small>packaging</small></span>
</a>

<style>
  .logo { display: inline-flex; flex: none; align-items: center; gap: 11px; text-decoration: none; color: #0b1324; white-space: nowrap; }
  .glyph { width: 30px; height: 21px; fill: #0b3a9e; flex: none; }
  .words { display: flex; flex-direction: column; line-height: 1; }
  b { font-weight: 800; font-size: 17px; letter-spacing: 0.06em; }
  small { font-weight: 500; font-size: 11px; letter-spacing: 0.28em; margin-top: 4px; opacity: 0.6; }
  .light { color: #ffffff; }
  .light .glyph { fill: #ffffff; }
</style>
