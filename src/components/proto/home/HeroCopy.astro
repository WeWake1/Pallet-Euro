---
// The headline the owner chose ("Europe's standard pallet, made in India."), with the lede,
// the calls to action and the EPAL licence line. Heroes place it; --hc-delay delays its entrance.
import Icon from '../Icon.astro';
import { CERTS } from '../../../data/certificates';

interface Props { licence?: boolean; size?: 'xl' | 'lg'; class?: string; style?: string }
const { licence = true, size = 'xl', class: cls = '', style = '' } = Astro.props;
const epal = CERTS[0];
---
<div class:list={['hc', size, cls]} style={style}>
  <h1>
    <span class="ln"><span>Europe’s standard pallet,</span></span>
    <span class="ln"><span class="blue">made in India.</span></span>
  </h1>
  <p class="lede">EPAL Euro pallets and CP pallets, built under licence from the European Pallet Association and heat treated to ISPM-15 for export.</p>
  <div class="actions">
    <a class="btn primary" href="#quote">Request a quote</a>
    <a class="more" href="#range">Explore the range <Icon name="arrow-right" size={18} /></a>
  </div>
  {licence && (
    <a class="licence" href={epal.verifyUrl} rel="noopener">
      <img src="/dev/stamps/epal.png" alt="" width="64" height="32" />
      <span>
        <b>Licensed EPAL producer</b>
        <em>Licence <mark>{epal.number}</mark> · verify on EPAL’s register <Icon name="arrow-up-right" size={14} /></em>
      </span>
    </a>
  )}
</div>

<style>
  .hc { --d: var(--hc-delay, 0s); position: relative; z-index: 2; max-width: 600px; }
  .hc.wide { max-width: 940px; }
  h1 { font-size: clamp(42px, 5.4vw, 84px); line-height: 1.02; font-weight: 600; letter-spacing: -0.035em; }
  .lg h1 { font-size: clamp(40px, 4.6vw, 72px); }
  .ln { display: block; overflow: hidden; padding-bottom: 0.06em; text-wrap: balance; }
  .ln > span { display: inline-block; animation: lineUp 1.1s var(--ease) both; animation-delay: var(--d); }
  .ln:nth-child(2) > span { animation-delay: calc(var(--d) + 0.12s); }
  .blue { color: var(--blue); }
  .lede { margin-top: 24px; max-width: 30em; font-size: 19px; line-height: 1.6; font-weight: 450; color: var(--ink-2); text-wrap: pretty; animation: fadeUp 1s var(--ease) both; animation-delay: calc(var(--d) + 0.3s); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 26px; margin-top: 32px; animation: fadeUp 1s var(--ease) both; animation-delay: calc(var(--d) + 0.42s); }
  .licence { display: inline-flex; align-items: center; gap: 16px; margin-top: 36px; padding: 12px 20px 12px 14px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255, 255, 255, 0.82); backdrop-filter: blur(8px); color: var(--ink); text-decoration: none; transition: border-color 0.3s, background 0.3s; animation: fadeUp 1s var(--ease) both; animation-delay: calc(var(--d) + 0.56s); }
  .licence:hover { border-color: var(--blue); background: var(--blue-soft); }
  .licence img { width: 64px; height: auto; }
  .licence span { display: flex; flex-direction: column; gap: 3px; }
  .licence b { font-size: 15px; font-weight: 700; }
  .licence em { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 2px 5px; font-style: normal; font-size: 13.5px; color: var(--ink-3); }
  @keyframes lineUp { from { transform: translateY(105%); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } }
  @media (max-width: 640px) {
    h1, .lg h1 { font-size: 40px; }
    .lede { font-size: 17px; margin-top: 18px; }
    .actions { gap: 20px; margin-top: 26px; }
    .licence { margin-top: 26px; }
  }
</style>
