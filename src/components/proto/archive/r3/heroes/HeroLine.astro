---
// PROTOTYPE round 3 · Hero A, "The Line": the whole Pallet Euro range rolls along a production
// line under the headline. Every pallet passes a quality check; the readout names it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import HeroCopy from '../HeroCopy.astro';
import Icon from '../../../Icon.astro';
import { RANGE28 } from '../../../../../data/range28';

const imgs = import.meta.glob('../../../../../assets/dev-renders/cut/*.webp', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const order = ['EPAL 1', 'CP3', 'PW-02', 'EPAL 2', 'HW-01', 'CP1', 'GMA', 'EPAL 3', 'CP6', 'PC-1208', 'PW-04', 'CP7', 'HW-03', 'CP2', 'PW-06', 'CP9', 'HW-05', 'CP4', 'PW-08', 'CP8', 'HW-02', 'CP5', 'PW-01', 'HW-06', 'PW-03', 'HW-04', 'PW-05', 'PW-07'];
const items = order.map((code) => {
  const p = RANGE28.find((x) => x.code === code)!;
  return { ...p, img: imgs[`../../../../../assets/dev-renders/cut/${p.slug}.webp`] };
});
---
<section class="hero line-hero">
    <HeroCopy licence={false} class="copy wide" />
    <aside class="readout" aria-live="polite">
      <span class="r-k">At the quality check</span>
      <div class="r-swap" data-r>
        <b data-r-code>EPAL 1</b>
        <span data-r-name>Euro pallet · 1200 × 800 × 144 mm</span>
        <em data-r-ok><Icon name="check-circle" size={18} /> <span>Built to the EPAL drawing</span></em>
      </div>
      <a class="lic" href="https://www.epal-pallets.org/eu-en/licensee-search" rel="noopener">
        <img src="/dev/stamps/epal.png" alt="" width="54" height="27" />
        <span>Licensed EPAL producer · <mark>IND-0XX</mark></span>
        <Icon name="arrow-up-right" size={14} />
      </a>
    </aside>

  <div class="line" data-line>
    <div class="gate" aria-hidden="true"><span>Quality check</span></div>
    <div class="track">
      {items.map((p, i) => (
        <div class="item" data-code={p.code} data-name={p.name} data-size={`${p.L} × ${p.W} × ${p.H} mm`} data-epal={p.epal ? '1' : ''}>
          <span class="chip"><Icon name="check-circle" size={15} />{p.code}</span>
          <Image src={p.img} alt={`${p.code} ${p.name.toLowerCase()}, ${p.L} × ${p.W} mm`} widths={[320, 640]} sizes="300px" loading={i < 7 ? 'eager' : 'lazy'} draggable="false" />
        </div>
      ))}
    </div>
    <div class="belt" aria-hidden="true"></div>
    <div class="rollers" aria-hidden="true">{Array.from({ length: 34 }, () => <i></i>)}</div>
    <p class="caption">All 28 pallets on one line. Hover to stop it.</p>
  </div>
</section>

<style>
  .line-hero { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); grid-template-rows: auto 1fr; grid-template-areas: 'copy readout' 'line line'; column-gap: 40px; min-height: calc(100vh - 80px); padding: 24px 0 0; }
  .line-hero > :global(.copy) { grid-area: copy; align-self: end; margin-left: var(--pad); }
  .readout { grid-area: readout; align-self: end; margin-right: var(--pad); display: flex; flex-direction: column; gap: 6px; padding: 26px 26px 22px; border-radius: 24px; background: var(--mist); }
  .r-k { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
  .r-swap { display: flex; flex-direction: column; gap: 4px; min-height: 108px; }
  .r-swap.swap { animation: swapIn 0.55s var(--ease); }
  @keyframes swapIn { from { opacity: 0; transform: translateY(10px); } }
  .r-swap b { font-size: 40px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .r-swap > span { font-size: 16px; color: var(--ink-2); }
  .r-swap em { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; font-style: normal; font-size: 15px; font-weight: 650; color: var(--blue); }
  .lic { display: flex; align-items: center; gap: 10px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--ink-2); font-size: 14px; font-weight: 600; text-decoration: none; }
  .lic img { width: 54px; height: auto; }
  .lic:hover { color: var(--blue); }

  .line { grid-area: line; position: relative; min-height: 330px; margin-top: 24px; overflow: hidden; touch-action: pan-y; --gx: 62%; }
  .track { position: absolute; left: 0; right: 0; bottom: 70px; height: 260px; }
  .item { position: absolute; left: 0; bottom: 0; width: var(--iw, 300px); will-change: transform; user-select: none; }
  .item :global(img) { display: block; width: 100%; height: auto; pointer-events: none; }
  .item::after { content: ''; position: absolute; left: 10%; right: 10%; bottom: -8px; height: 20px; background: radial-gradient(ellipse at center, rgba(11, 19, 36, 0.2), transparent 70%); z-index: -1; }
  .chip { position: absolute; left: 50%; top: -14px; display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px; background: var(--blue); color: #fff; font-size: 13px; font-weight: 700; white-space: nowrap; opacity: 0; transform: translate(-50%, 10px) scale(0.9); transition: opacity 0.35s var(--ease), transform 0.45s var(--ease); }
  .item.checked .chip { opacity: 1; transform: translate(-50%, -100%) scale(1); }
  .gate { position: absolute; left: var(--gx); bottom: 62px; width: 2px; height: 290px; background: var(--blue); }
  .gate::before { content: ''; position: absolute; left: -36px; right: -36px; top: 0; bottom: 0; background: rgba(11, 58, 158, 0.05); }
  .gate span { position: absolute; left: 50%; top: -6px; transform: translate(-50%, -100%); padding: 6px 12px; border-radius: 999px; background: #fff; box-shadow: inset 0 0 0 1px #d9e2f5; color: var(--blue); font-size: 12px; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; }
  .belt { position: absolute; left: 0; right: 0; bottom: 58px; height: 10px; background-color: #e6eaf0; background-image: repeating-linear-gradient(90deg, rgba(11, 19, 36, 0.07) 0 2px, transparent 2px 48px); background-position: var(--belt, 0px) 0; }
  .rollers { position: absolute; left: 0; right: 0; bottom: 30px; display: flex; justify-content: space-between; padding: 0 14px; }
  .rollers i { position: relative; width: 22px; height: 22px; border-radius: 50%; background: #eef1f5; transform: rotate(var(--roll, 0deg)); }
  .rollers i::after { content: ''; position: absolute; left: 3px; right: 3px; top: 50%; height: 2px; margin-top: -1px; border-radius: 2px; background: #d5dce6; }
  .caption { position: absolute; left: var(--pad); bottom: 0; padding-bottom: 2px; font-size: 13px; font-weight: 600; color: var(--ink-3); }

  @media (max-width: 1100px) {
    .line-hero { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'copy' 'line' 'readout'; min-height: auto; }
    .line-hero > :global(.copy) { margin: 0 var(--pad); }
    .readout { margin: 8px var(--pad) 0; }
    .line { min-height: 300px; --gx: 66%; }
    .item { --iw: 230px; }
    .track { height: 200px; }
    .gate { height: 196px; }
    .rollers i { width: 24px; height: 24px; }
  }
  @media (max-width: 640px) {
    .readout { padding: 18px; }
    .r-swap { min-height: 92px; }
    .r-swap b { font-size: 30px; }
    .item { --iw: 190px; }
  }
</style>

<script>
  import { whenShown } from '../when-shown';

  const root = document.querySelector<HTMLElement>('.line-hero');
  const line = root?.querySelector<HTMLElement>('[data-line]');
  if (root && line) {
    whenShown('A', line, () => {
      const items = [...line.querySelectorAll<HTMLElement>('.item')];
      const swap = root.querySelector<HTMLElement>('[data-r]')!;
      const rCode = root.querySelector<HTMLElement>('[data-r-code]')!;
      const rName = root.querySelector<HTMLElement>('[data-r-name]')!;
      const rOk = root.querySelector<HTMLElement>('[data-r-ok] span')!;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let iw = 300, spacing = 400, total = 0, gx = 0;
      const measure = () => {
        iw = items[0].getBoundingClientRect().width || 300;
        spacing = iw * 1.36;
        total = items.length * spacing;
        gx = line.clientWidth * (parseFloat(getComputedStyle(line).getPropertyValue('--gx')) / 100 || 0.62);
      };
      measure();
      new ResizeObserver(measure).observe(line);
      let offset = spacing * 2.2;
      let speed = 0;
      let target = reduce ? 0 : 64;
      const prev: number[] = [];
      const check = (el: HTMLElement) => {
        el.classList.add('checked');
        rCode.textContent = el.dataset.code!;
        rName.textContent = `${el.dataset.name} · ${el.dataset.size}`;
        rOk.textContent = el.dataset.epal ? 'Built to the EPAL drawing' : 'Checked against our SOP';
        swap.classList.remove('swap');
        void swap.offsetWidth;
        swap.classList.add('swap');
      };
      let last = performance.now();
      const tick = (now: number) => {
        requestAnimationFrame(tick);
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        speed += (target - speed) * Math.min(1, dt * 3.5);
        offset = (offset + speed * dt) % total;
        items.forEach((el, i) => {
          const x = ((i * spacing + offset) % total) - spacing;
          el.style.transform = `translate3d(${x}px,0,0)`;
          const cx = x + iw / 2;
          const p = prev[i];
          if (p !== undefined) {
            if (p < gx && cx >= gx) check(el);
            if (cx < p - spacing) el.classList.remove('checked');
          }
          prev[i] = cx;
        });
        line.style.setProperty('--belt', `${offset}px`);
        line.style.setProperty('--roll', `${(offset / (Math.PI * 32)) * 360}deg`);
      };
      requestAnimationFrame(tick);
      line.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') target = 0; });
      line.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && !reduce) target = 64; });
      line.addEventListener('click', () => { if (!reduce) target = target ? 0 : 64; });
      return {};
    });
  }
</script>
