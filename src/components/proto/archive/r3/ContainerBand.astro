---
// "Your next container, on EPAL pallets." The quote band the owner liked (round 2, C).
import Icon from '../../Icon.astro';
---
<section class="band" id="quote">
  <h2 data-reveal>Your next container,<br />on EPAL pallets.</h2>
  <div class="actions" data-reveal>
    <a class="btn white" href="#">Request a quotation</a>
    <a class="btn ghost" href="#"><Icon name="whatsapp-logo" size={18} />WhatsApp</a>
  </div>
</section>

<style>
  .band { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; padding: 100px var(--pad); background: var(--blue); color: #fff; }
  h2 { font-family: 'Sofia Sans Condensed Variable', 'Arial Narrow', sans-serif; font-weight: 850; text-transform: uppercase; font-size: clamp(42px, 4.8vw, 76px); line-height: 0.92; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .actions :global(.btn) { font-family: 'Sofia Sans Condensed Variable', 'Arial Narrow', sans-serif; font-size: 18px; font-weight: 750; letter-spacing: 0.02em; height: 54px; padding: 0 28px; }
  @media (max-width: 1100px) { .band { padding: 72px var(--pad); } }
</style>
