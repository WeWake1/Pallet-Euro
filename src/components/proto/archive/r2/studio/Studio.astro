<script>
  // Turntable: cross-fade through the studio angles; clicking a label jumps to it.
  document.querySelectorAll<HTMLElement>('[data-turntable]').forEach((root) => {
    const imgs = [...root.querySelectorAll<HTMLImageElement>('.stage img')];
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.views button')];
    const DUR = 4200;
    let i = 0;
    let timer = 0;
    const show = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      imgs.forEach((im, k) => im.classList.toggle('on', k === i));
      btns.forEach((b, k) => {
        b.classList.remove('on');
        if (k === i) { void b.offsetWidth; b.classList.add('on'); }
      });
      window.clearTimeout(timer);
      timer = window.setTimeout(() => show(i + 1), DUR);
    };
    btns.forEach((b, k) => b.addEventListener('click', () => show(k)));
    root.style.setProperty('--dur', DUR + 'ms');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setTimeout(() => show(1), DUR);
    document.addEventListener('visibilitychange', () => { if (document.hidden) window.clearTimeout(timer); else show(i); });
  });
</script>
