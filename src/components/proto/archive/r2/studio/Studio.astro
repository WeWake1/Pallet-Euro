---
// PROTOTYPE · Direction A, "Studio": airy and editorial, product first.
// The hero is the EPAL 1 render on pure white, turning through its five studio angles.
import { Image } from 'astro:assets';
import Logo from '../../../Logo.astro';
import Icon from '../../../Icon.astro';
import { CERTS, RANGE } from '../../../../../data/certificates';
import v1 from '../../../../../assets/dev-renders/white/epal1-1.webp';
import v2 from '../../../../../assets/dev-renders/white/epal1-2.webp';
import v3 from '../../../../../assets/dev-renders/white/epal1-3.webp';
import v4 from '../../../../../assets/dev-renders/white/epal1-4.webp';
import v5 from '../../../../../assets/dev-renders/white/epal1-5.webp';
import e2a from '../../../../../assets/dev-renders/white/epal2-1.webp';
import e2b from '../../../../../assets/dev-renders/white/epal2-2.webp';
import e3a from '../../../../../assets/dev-renders/white/epal3-1.webp';
import e3b from '../../../../../assets/dev-renders/white/epal3-2.webp';
import cp1 from '../../../../../assets/dev-renders/white/cp1-1.webp';
import cp3 from '../../../../../assets/dev-renders/white/cp3-1.webp';
import cp6 from '../../../../../assets/dev-renders/white/cp6-1.webp';
import cp7 from '../../../../../assets/dev-renders/white/cp7-1.webp';
import cutout from '../../../../../assets/dev-renders/epal1-1.webp';

const views = [
  { img: v1, label: 'Front corner' },
  { img: v2, label: 'Long side' },
  { img: v3, label: 'Floor level' },
  { img: v4, label: 'From above' },
  { img: v5, label: 'Underside' },
];
const r = Object.fromEntries(RANGE.map((p) => [p.id, p]));
const epals = [
  { p: r.epal1, a: v1, b: v2, line: 'The Euro pallet. The one Europe’s pallet pool runs on.' },
  { p: r.epal2, a: e2a, b: e2b, line: 'Wide base for heavy, bulky loads and roller conveyors.' },
  { p: r.epal3, a: e3a, b: e3b, line: 'The 1200 × 1000 footprint for chemicals and building materials.' },
];
const cps = [
  { p: r.cp1, img: cp1 },
  { p: r.cp3, img: cp3 },
  { p: r.cp6, img: cp6 },
  { p: r.cp7, img: cp7 },
];
const kg = (n?: number) => (n ? n.toLocaleString('en-IN') + ' kg' : '');
const epal = CERTS[0];
const others = CERTS.slice(1);
---
<div class="studio">
  <header class="head">
    <Logo />
    <nav class="nav" aria-label="Main">
      <a href="#a-range">Products</a><a href="#a-certs">Certifications</a><a href="#">About</a><a href="#">Contact</a>
    </nav>
    <a class="btn primary sm" href="#">Request a quote</a>
  </header>

  <section class="hero">
    <div class="copy">
      <h1>
        <span class="ln"><span>Europe’s standard pallet,</span></span>
        <span class="ln"><span class="blue">made in India.</span></span>
      </h1>
      <p class="lede">
        EPAL Euro pallets and CP pallets, built under licence from the European Pallet Association and heat
        treated to ISPM-15 for export.
      </p>
      <div class="actions">
        <a class="btn primary" href="#">Request a quote</a>
        <a class="more" href="#a-range">Explore the range <Icon name="arrow-right" size={18} /></a>
      </div>
      <a class="licence" href={epal.verifyUrl} rel="noopener">
        <img src="/dev/stamps/epal.png" alt="" width="72" height="36" />
        <span>
          <b>Licensed EPAL producer</b>
          <em>Licence <mark>{epal.number}</mark> · verify on EPAL’s register <Icon name="arrow-up-right" size={14} /></em>
        </span>
      </a>
    </div>

    <figure class="turntable" data-turntable>
      <div class="stage">
        {views.map((v, i) => (
          <Image
            class={i === 0 ? 'on' : ''}
            src={v.img}
            alt={`EPAL 1 Euro pallet, ${v.label.toLowerCase()} view`}
            widths={[720, 1080, 1600]}
            sizes="(max-width: 1100px) 92vw, 760px"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
      <figcaption>
        <ol class="views">
          {views.map((v, i) => (
            <li><button type="button" data-i={i} class={i === 0 ? 'on' : ''}><span class="bar"><i></i></span>{v.label}</button></li>
          ))}
        </ol>
        <span class="spec">EPAL 1 · 1200 × 800 × 144 mm</span>
      </figcaption>
    </figure>
  </section>

  <section class="strip" aria-label="Certifications">
    <ul>
      {CERTS.map((c, i) => (
        <li data-reveal style={`transition-delay:${i * 60}ms`}>
          <a href="#a-certs">
            <Icon name={c.icon} size={26} />
            <span><b>{c.short}</b><em>{c.id === 'epal' ? 'Licensed' : c.id === 'ispm15' ? 'Heat treated' : c.id === 'sop' ? 'Documented' : c.id === 'tm' ? 'Registered' : 'Certified'}</em></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="range" id="a-range">
    <div class="sec-head" data-reveal>
      <h2>Every EPAL pallet,<br />built to the drawing.</h2>
      <div>
        <p>Board widths, block positions and all 78 nails of the Euro pallet follow EPAL’s technical regulations, pallet after pallet.</p>
        <a class="more" href="#">See all 28 pallets <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>

    <div class="cards">
      {epals.map(({ p, a, b, line }, i) => (
        <a class="card" href="#" data-reveal style={`transition-delay:${i * 90}ms`}>
          <div class="pic">
            <Image src={a} alt={`${p.code} pallet, ${p.L} × ${p.W} mm`} widths={[480, 720]} sizes="(max-width: 900px) 92vw, 420px" />
            <Image class="alt" src={b} alt="" widths={[480, 720]} sizes="(max-width: 900px) 92vw, 420px" />
          </div>
          <div class="body">
            <span class="code">{p.code}</span>
            <h3>{p.name}</h3>
            <p>{line}</p>
            <dl>
              <div><dt>Size</dt><dd>{p.L} × {p.W} × {p.H} mm</dd></div>
              <div><dt>Safe load</dt><dd>{kg(p.swl)}</dd></div>
              <div><dt>Weight</dt><dd>≈ {kg(p.kg)}</dd></div>
            </dl>
          </div>
        </a>
      ))}
    </div>

    <div class="cp" data-reveal>
      <div class="cp-head">
        <h3>CP pallets for the chemical industry</h3>
        <a class="more" href="#">All nine CP types <Icon name="arrow-right" size={18} /></a>
      </div>
      <div class="cp-row">
        {cps.map(({ p, img }) => (
          <a class="mini" href="#">
            <Image src={img} alt={`${p.code} chemical pallet, ${p.L} × ${p.W} mm`} widths={[360, 540]} sizes="(max-width: 900px) 45vw, 300px" />
            <b>{p.code}</b><span>{p.L} × {p.W} mm</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="certs" id="a-certs">
    <div class="sec-head" data-reveal>
      <h2>Every certificate,<br />one click from proof.</h2>
      <div>
        <p>We don’t ask you to take our word for it. Each certificate below links to the register of the body that issued it.</p>
      </div>
    </div>
    <div class="grid">
      <article class="cert feature" data-reveal>
        <div class="f-top">
          <img src="/dev/stamps/epal.png" alt="" width="96" height="48" />
          <span class="tag">Licensed producer</span>
        </div>
        <h3>{epal.name}</h3>
        <p class="iss">{epal.issuer}</p>
        <p class="num"><span>Licence no.</span><mark>{epal.number}</mark></p>
        <a class="btn white" href={epal.verifyUrl} rel="noopener">Verify on EPAL’s register <Icon name="arrow-up-right" size={16} /></a>
      </article>
      {others.map((c, i) => (
        <article class="cert" data-reveal style={`transition-delay:${(i % 3) * 80}ms`}>
          <Icon name={c.icon} size={30} />
          <h3>{c.name}</h3>
          <p class="iss">{c.issuer}</p>
          <p class="num"><span>No.</span><mark>{c.number}</mark></p>
          <p class="valid">{c.valid}</p>
          {c.verifyUrl ? (
            <a class="verify" href={c.verifyUrl} rel="noopener">Verify on {c.verifyLabel} <Icon name="arrow-up-right" size={14} /></a>
          ) : (
            <span class="verify muted">On request</span>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="band-copy">
      <h2>Planning a shipment to Europe?</h2>
      <p>Tell us the pallet, the quantity and the port of loading, and we will send you a quote.</p>
      <div class="actions">
        <a class="btn white" href="#">Request a quote</a>
        <a class="btn ghost" href="#"><Icon name="whatsapp-logo" size={18} />WhatsApp us</a>
      </div>
    </div>
    <Image class="band-img" src={cutout} alt="" widths={[600, 900]} sizes="(max-width: 900px) 80vw, 560px" />
  </section>

  <footer class="foot">
    <Logo />
    <nav aria-label="Footer"><a href="#">Products</a><a href="#">Certifications</a><a href="#">About</a><a href="#">Contact</a><a href="#">Privacy</a></nav>
    <p>© 2026 Pallet Euro Packaging. EPAL® is a registered trademark of the European Pallet Association e.V.</p>
  </footer>
</div>

<style>
  .studio {
    --white: #ffffff;
    --mist: #f4f6fa;
    --ink: #0b1324;
    --ink-2: #3c4658;
    --ink-3: #7a8396;
    --line: #e3e8ef;
    --blue: #0b3a9e;
    --blue-deep: #072a75;
    --blue-soft: #edf2fc;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    font-family: 'Urbanist Variable', system-ui, sans-serif;
    color: var(--ink);
    background: var(--white);
    overflow-x: clip;
  }
  .studio mark { background: none; color: inherit; border-bottom: 1px dashed currentColor; }
  .studio :global(svg) { flex: none; }

  /* buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; white-space: nowrap; height: 52px; padding: 0 26px; border-radius: 999px; font-size: 16px; font-weight: 650; text-decoration: none; transition: background 0.3s, transform 0.3s var(--ease), box-shadow 0.3s; }
  .btn.sm { height: 44px; padding: 0 20px; font-size: 15px; }
  .primary { background: var(--blue); color: #fff; box-shadow: 0 10px 24px -12px rgba(11, 58, 158, 0.6); }
  .primary:hover { background: var(--blue-deep); transform: translateY(-1px); }
  .white { background: #fff; color: var(--blue); }
  .white:hover { transform: translateY(-1px); box-shadow: 0 14px 28px -16px rgba(0, 0, 0, 0.45); }
  .ghost { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.45); }
  .ghost:hover { box-shadow: inset 0 0 0 1.5px #fff; }
  .more { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 650; font-size: 16px; text-decoration: none; }
  .more :global(svg) { transition: transform 0.35s var(--ease); }
  .more:hover :global(svg) { transform: translateX(4px); }

  /* header */
  .head { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; gap: 48px; padding: 18px 56px; background: rgba(255, 255, 255, 0.86); backdrop-filter: saturate(1.4) blur(14px); transition: box-shadow 0.3s; }
  :global(html.scrolled) .head { box-shadow: 0 1px 0 var(--line); }
  .nav { display: flex; gap: 36px; margin-left: auto; }
  .nav a { color: var(--ink-2); font-size: 16px; font-weight: 550; text-decoration: none; transition: color 0.25s; }
  .nav a:hover { color: var(--blue); }

  /* hero */
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 40px; align-items: center; padding: 40px 56px 72px; min-height: calc(100vh - 80px); }
  h1 { font-size: clamp(44px, 5.4vw, 84px); line-height: 1.02; font-weight: 600; letter-spacing: -0.035em; }
  .ln { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .ln > span { display: inline-block; animation: lineUp 1.1s var(--ease) both; }
  .ln:nth-child(2) > span { animation-delay: 0.12s; }
  @keyframes lineUp { from { transform: translateY(105%); } }
  .blue { color: var(--blue); }
  .lede { margin-top: 26px; max-width: 30em; font-size: 19px; line-height: 1.6; font-weight: 450; color: var(--ink-2); text-wrap: pretty; animation: fadeUp 1s 0.35s var(--ease) both; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; margin-top: 36px; animation: fadeUp 1s 0.45s var(--ease) both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } }
  .licence { display: inline-flex; align-items: center; gap: 18px; margin-top: 44px; padding: 14px 22px 14px 16px; border: 1px solid var(--line); border-radius: 18px; color: var(--ink); text-decoration: none; transition: border-color 0.3s, background 0.3s; animation: fadeUp 1s 0.6s var(--ease) both; }
  .licence:hover { border-color: var(--blue); background: var(--blue-soft); }
  .licence img { width: 72px; height: auto; }
  .licence span { display: flex; flex-direction: column; gap: 3px; }
  .licence b { font-size: 16px; font-weight: 700; }
  .licence em { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 2px 5px; font-style: normal; font-size: 14px; color: var(--ink-3); }
  .licence mark { white-space: nowrap; }

  .turntable { margin: 0; animation: fadeUp 1.2s 0.2s var(--ease) both; }
  .stage { position: relative; aspect-ratio: 4 / 3; }
  .stage :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transform: scale(1.035); transition: opacity 1.1s var(--ease), transform 5.5s linear; }
  .stage :global(img.on) { opacity: 1; transform: scale(1); }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 8px; padding: 0 4%; }
  .views { display: flex; gap: 6px; }
  .views button { display: flex; flex-direction: column; gap: 9px; font: inherit; font-size: 13px; font-weight: 600; color: var(--ink-3); cursor: pointer; padding: 6px 4px; transition: color 0.25s; }
  .views button.on, .views button:hover { color: var(--ink); }
  .bar { display: block; width: 72px; height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 100%; background: var(--blue); transform: scaleX(0); transform-origin: left; }
  .views button.on .bar i { animation: fill var(--dur, 4.2s) linear forwards; }
  @keyframes fill { to { transform: scaleX(1); } }
  .spec { font-size: 14px; font-weight: 600; color: var(--ink-3); white-space: nowrap; }

  /* certification strip */
  .strip { background: var(--mist); padding: 10px 56px; }
  .strip ul { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); }
  .strip li + li { border-left: 1px solid var(--line); }
  .strip a { display: flex; align-items: center; gap: 12px; padding: 22px 18px; color: var(--ink); text-decoration: none; transition: color 0.25s; }
  .strip a:hover { color: var(--blue); }
  .strip :global(svg) { color: var(--blue); }
  .strip span { display: flex; flex-direction: column; gap: 2px; }
  .strip b { font-size: 15px; font-weight: 700; white-space: nowrap; }
  .strip em { font-style: normal; font-size: 13px; color: var(--ink-3); }

  /* sections */
  .sec-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: end; margin-bottom: 56px; }
  h2 { font-size: clamp(34px, 3.8vw, 56px); line-height: 1.06; font-weight: 600; letter-spacing: -0.03em; }
  .sec-head p { font-size: 18px; line-height: 1.6; color: var(--ink-2); margin-bottom: 18px; max-width: 30em; }

  .range { padding: 140px 56px 120px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; color: var(--ink); text-decoration: none; background: #fff; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), border-color 0.3s, opacity 0.9s var(--ease); }
  .card:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -30px rgba(11, 19, 36, 0.3); border-color: transparent; }
  .pic { position: relative; aspect-ratio: 4 / 3; background: #fff; }
  .pic :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 0.6s var(--ease), transform 0.8s var(--ease); }
  .pic :global(img.alt) { opacity: 0; }
  .card:hover .pic :global(img) { transform: scale(1.03); }
  .card:hover .pic :global(img.alt) { opacity: 1; }
  .body { padding: 4px 28px 28px; }
  .code { font-size: 13px; font-weight: 750; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); }
  .body h3 { margin-top: 6px; font-size: 26px; font-weight: 650; letter-spacing: -0.02em; }
  .body p { margin-top: 8px; font-size: 16px; line-height: 1.55; color: var(--ink-2); min-height: 3.1em; }
  dl { display: grid; grid-template-columns: repeat(3, auto); justify-content: space-between; gap: 12px; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
  dt { font-size: 12px; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  dd { margin-top: 4px; font-size: 15px; font-weight: 650; white-space: nowrap; }

  .cp { margin-top: 88px; }
  .cp-head { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; margin-bottom: 24px; }
  .cp-head h3 { font-size: 26px; font-weight: 650; letter-spacing: -0.02em; }
  .cp-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .mini { display: grid; gap: 2px; padding: 0 0 18px; border-radius: 22px; background: var(--mist); color: var(--ink); text-decoration: none; overflow: hidden; transition: background 0.3s; }
  .mini:hover { background: var(--blue-soft); }
  .mini :global(img) { width: 100%; height: auto; mix-blend-mode: multiply; transition: transform 0.6s var(--ease); }
  .mini:hover :global(img) { transform: scale(1.04); }
  .mini b { padding: 0 20px; font-size: 18px; font-weight: 700; }
  .mini span { padding: 0 20px; font-size: 14px; color: var(--ink-3); }

  /* certificates */
  .certs { padding: 120px 56px 140px; background: var(--mist); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .cert { display: flex; flex-direction: column; gap: 8px; padding: 28px; border-radius: 24px; background: #fff; border: 1px solid var(--line); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), opacity 0.9s var(--ease); }
  .cert:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -28px rgba(11, 19, 36, 0.3); }
  .cert > :global(svg) { color: var(--blue); margin-bottom: 10px; }
  .cert h3 { font-size: 21px; font-weight: 700; letter-spacing: -0.015em; }
  .iss { font-size: 15px; line-height: 1.45; color: var(--ink-3); }
  .num { display: flex; align-items: baseline; gap: 8px; margin-top: 6px; font-size: 16px; font-weight: 650; }
  .num span { font-size: 12px; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .valid { font-size: 14px; color: var(--ink-2); }
  .verify { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 16px; font-size: 15px; font-weight: 650; color: var(--blue); text-decoration: none; }
  .verify:hover { text-decoration: underline; text-underline-offset: 4px; }
  .verify.muted { color: var(--ink-3); }
  .feature { grid-column: span 2; background: var(--blue); border-color: var(--blue); color: #fff; padding: 36px; }
  .feature .f-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .feature img { width: 96px; height: auto; filter: invert(1) brightness(2); }
  .tag { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 7px 14px; border-radius: 999px; background: rgba(255, 255, 255, 0.14); }
  .feature h3 { font-size: 34px; letter-spacing: -0.025em; }
  .feature .iss { color: rgba(255, 255, 255, 0.72); font-size: 17px; }
  .feature .num { font-size: 26px; margin: 14px 0 22px; }
  .feature .num span { color: rgba(255, 255, 255, 0.6); }
  .feature .btn { align-self: flex-start; }

  /* closing band */
  .band { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; gap: 40px; margin: 120px 56px; padding: 72px 72px; border-radius: 36px; background: var(--blue); color: #fff; overflow: hidden; }
  .band h2 { color: #fff; }
  .band p { margin-top: 16px; font-size: 19px; line-height: 1.6; color: rgba(255, 255, 255, 0.78); max-width: 28em; }
  .band .actions { animation: none; }
  .band-img { width: 120%; max-width: none; height: auto; margin-right: -20%; filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.35)); }

  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: 40px 56px 96px; border-top: 1px solid var(--line); }
  .foot nav { display: flex; flex-wrap: wrap; gap: 28px; }
  .foot nav a { color: var(--ink-2); text-decoration: none; font-weight: 550; }
  .foot p { width: 100%; font-size: 13px; color: var(--ink-3); }

  @media (max-width: 1100px) {
    .head { padding: 14px 24px; }
    .nav { display: none; }
    .head .btn { margin-left: auto; }
    .hero { grid-template-columns: minmax(0, 1fr); padding: 28px 24px 56px; min-height: auto; gap: 24px; }
    .strip { padding: 4px 24px; }
    .strip ul { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .strip li:nth-child(5) { border-left: 0; }
    .range, .certs { padding: 96px 24px; }
    .sec-head { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .cards { grid-template-columns: minmax(0, 1fr); }
    .cp-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
