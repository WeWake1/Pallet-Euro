---
// PROTOTYPE round 10: the industries that ship on EPAL pallets, as plain text under the hero (decision #74: in the
// HTML for search; no customers claimed). The hero's script marks the one on screen with .on (data-key).
import { INDUSTRIES } from './industries';
---
<div class="ind" aria-label="Industries">
  <span class="lead">Where EPAL pallets work</span>
  <ul>
    {INDUSTRIES.map((i) => <li data-key={i.key}>{i.name}</li>)}
  </ul>
</div>

<style>
  .ind { position: absolute; left: var(--pad); right: var(--pad); bottom: 26px; z-index: 3; display: flex; align-items: baseline; gap: 18px;
    font-size: 13.5px; pointer-events: none; }
  .lead { flex: none; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 11.5px; color: var(--ink-3); }
  ul { display: flex; flex-wrap: wrap; gap: 4px 16px; list-style: none; margin: 0; padding: 0; }
  li { font-weight: 550; color: var(--ink-3); transition: color 0.5s; white-space: nowrap; }
  li:global(.on) { color: var(--blue); }
  @media (max-width: 900px) {
    .ind { position: relative; left: auto; right: auto; bottom: auto; flex-direction: column; gap: 8px; margin: 28px 0 8px; font-size: 13px; }
  }
</style>
