---
// PROTOTYPE round 10 · B "Lift" (decision #75: the owner liked the forklift idea): a forklift raises an EPAL 1 of bottled
// drinks to the second beam level of a racking already stocked with the other industries' loads, drives it in, sets
// it down and backs out; the camera rises with the load. Plays once by itself when the hero is shown (no cursor, no
// scroll), then rests on the full rack; "Play again" replays it. Frames: tools/render/hero/r10.py --job lift.
import HeroCopy from '../home/HeroCopy.astro';

const DIR = '/dev/r10/lift';
const COUNT = 132;
---
<section class="photo-hero r10-lift" data-key="B" data-dir={DIR} data-count={COUNT} aria-label="Pallet Euro Packaging" style="--pic-bg:#F2F2F1">
  <div class="pic" data-pic>
    <img src={`${DIR}/000.webp`} srcset={`${DIR}-sm/000.webp 960w, ${DIR}/000.webp 1920w`} sizes="100vw" width="1920" height="1080"
      fetchpriority="high" decoding="async" alt="A forklift lifting an EPAL 1 Euro pallet of bottled drinks into a racking stocked with loads from many industries" />
    <canvas aria-hidden="true"></canvas>
  </div>
  <div class="copy-wrap"><HeroCopy /></div>
  <button class="again" type="button" hidden>Play again</button>
</section>

<style>
  .r10-lift .pic img { object-position: 64% 50%; }
  .again { position: absolute; right: var(--pad); bottom: 28px; z-index: 3; height: 40px; padding: 0 18px; border: 0; border-radius: 999px;
    background: rgba(255, 255, 255, 0.9); box-shadow: inset 0 0 0 1px rgba(11, 19, 36, 0.1); font: inherit; font-size: 14px; font-weight: 650;
    color: var(--ink); cursor: pointer; }
  .again:hover { color: var(--blue); }
  @media (max-width: 900px) {
    .r10-lift .pic img { object-position: 70% 50%; }
    .again { top: 12px; right: 12px; bottom: auto; }
  }
</style>

<script>
  import { createSeq, frames } from '../r5/seq';
  import { whenShown } from '../home/when-shown';

  for (const root of document.querySelectorAll<HTMLElement>('.r10-lift')) {
    const pic = root.querySelector<HTMLElement>('[data-pic]')!;
    const again = root.querySelector<HTMLButtonElement>('.again')!;
    whenShown(root.dataset.key!, pic, () => {
      const count = Number(root.dataset.count);
      const small = innerWidth <= 900;
      const seq = createSeq(pic.querySelector('canvas')!, frames(small ? `${root.dataset.dir}-sm` : root.dataset.dir!, count),
        { x: small ? 0.7 : 0.64, y: 0.5 }, 0);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { seq.done.then(() => seq.show(count - 1)); return {}; }
      let playing = false;
      const play = () => {
        if (playing) return;
        playing = true;
        again.hidden = true;
        const t0 = performance.now(), dur = (count / 24) * 1000;
        const step = (now: number) => {
          const k = Math.min((now - t0) / dur, 1);
          seq.show(k * (count - 1));
          if (k < 1) requestAnimationFrame(step);
          else { playing = false; again.hidden = false; }
        };
        requestAnimationFrame(step);
      };
      again.addEventListener('click', play);
      seq.done.then(() => setTimeout(play, 700));
      return { replay: play };
    });
  }
</script>
