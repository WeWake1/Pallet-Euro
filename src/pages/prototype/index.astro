---
// PROTOTYPE (throwaway) · round 10 (24-25 Nov 2026): built from the owner's own idea (decisions #69-#75): an EPAL pallet
// carrying a different industry's load, one detailed, unbranded product per industry (tools/render/hero/loads.py).
//   A "The industries"  the owner's idea: the camera circles one EPAL 1 while its load changes, industry by industry
//   B "Lift"            a forklift raises a loaded EPAL 1 into a racking stocked with every industry's load
//   C "The delivery"    the forklift and the industries combined: one delivery after another drives up to the headline
// All three play by themselves (no cursor). Then the approved scroll stories: the Mark and the container.
// Switch with ?variant=A|B|C or the arrow keys. Earlier rounds: /prototype/round-2/ .. /round-9/.
import Proto from '../../layouts/Proto.astro';
import Switcher from '../../components/proto/Switcher.astro';
import '../../components/proto/home/home.css';
import Header from '../../components/proto/home/Header.astro';
import Range from '../../components/proto/home/Range.astro';
import CertifiedSteps from '../../components/proto/home/CertifiedSteps.astro';
import Footer from '../../components/proto/home/Footer.astro';
import HeroIndustries from '../../components/proto/r10/HeroIndustries.astro';
import HeroLift from '../../components/proto/r10/HeroLift.astro';
import HeroDelivery from '../../components/proto/r10/HeroDelivery.astro';
import MarkFilm from '../../components/proto/r5/MarkFilm.astro';
import ContainerFilm from '../../components/proto/r5/ContainerFilm.astro';
---
<Proto title="Round 10 · hero concepts · Pallet Euro (prototype)">
  <div class="pe">
    <Header />
    <main>
      <div class="variant" data-variant="A"><HeroIndustries /></div>
      <div class="variant" data-variant="B"><HeroLift /></div>
      <div class="variant" data-variant="C"><HeroDelivery /></div>
      <MarkFilm />
      <Range />
      <CertifiedSteps />
      <ContainerFilm />
    </main>
    <Footer />
  </div>
  <Switcher round="Round 10" variants={[{ key: 'A', name: 'The industries' }, { key: 'B', name: 'Lift' }, { key: 'C', name: 'The delivery' }]} />
</Proto>

<style is:global>
  /* Photo heroes: on computers the header floats transparent over the picture until the page scrolls. */
  @media (min-width: 901px) {
    html:not(.scrolled) .pe .head { background: transparent; backdrop-filter: none; }
  }
</style>
