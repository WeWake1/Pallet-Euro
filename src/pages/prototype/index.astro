---
// PROTOTYPE (throwaway) · round 8 (23 Nov 2026): no more moving the cursor (decision #58). One hero per kind of motion
// the owner picked (decision #59):
//   A "Built in layers"   a scroll story: scrolling takes the pallet apart (phones: plays once by itself)
//   B "The journey"       scenes that advance by themselves: India, the container, Europe
//   C "The family"        tap to transform: tap EPAL 1, EPAL 2, EPAL 3 or CP1 and the pallet rebuilds itself
//   D "Living photograph" plays by itself: round 4's Indian light as a slow, seamless camera glide
// Then the approved scroll stories: the Mark and the container. Switch with ?variant=A|B|C|D or the arrow keys.
// Earlier rounds: /prototype/round-2/ .. /round-7/.
import Proto from '../../layouts/Proto.astro';
import Switcher from '../../components/proto/Switcher.astro';
import '../../components/proto/home/home.css';
import Header from '../../components/proto/home/Header.astro';
import Range from '../../components/proto/home/Range.astro';
import CertifiedSteps from '../../components/proto/home/CertifiedSteps.astro';
import Footer from '../../components/proto/home/Footer.astro';
import HeroScroll from '../../components/proto/r8/HeroScroll.astro';
import HeroScenes from '../../components/proto/r8/HeroScenes.astro';
import HeroTransform from '../../components/proto/r8/HeroTransform.astro';
import HeroLoop from '../../components/proto/r8/HeroLoop.astro';
import MarkFilm from '../../components/proto/r5/MarkFilm.astro';
import ContainerFilm from '../../components/proto/r5/ContainerFilm.astro';
---
<Proto title="Round 8 · hero concepts · Pallet Euro (prototype)">
  <div class="pe">
    <Header />
    <main>
      <div class="variant" data-variant="A"><HeroScroll /></div>
      <div class="variant" data-variant="B"><HeroScenes /></div>
      <div class="variant" data-variant="C"><HeroTransform /></div>
      <div class="variant" data-variant="D"><HeroLoop /></div>
      <MarkFilm />
      <Range />
      <CertifiedSteps />
      <ContainerFilm />
    </main>
    <Footer />
  </div>
  <Switcher round="Round 8" variants={[{ key: 'A', name: 'Built in layers' }, { key: 'B', name: 'The journey' }, { key: 'C', name: 'The family' }, { key: 'D', name: 'Living photograph' }]} />
</Proto>

<style is:global>
  /* Photo heroes: on computers the header floats transparent over the picture until the page scrolls. */
  @media (min-width: 901px) {
    html:not(.scrolled) .pe .head { background: transparent; backdrop-filter: none; }
  }
</style>
