---
// PROTOTYPE ARCHIVE · round 5 (8 Nov 2026): three hero concepts, kept for reference. Owner's verdict
// (23 Nov 2026, decisions #39): B "In its place" disliked; no hero chosen. The Mark and container scroll
// stories were approved and continue on the live prototype (/prototype/).
import Proto from '../../layouts/Proto.astro';
import Switcher from '../../components/proto/Switcher.astro';
import '../../components/proto/home/home.css';
import Header from '../../components/proto/home/Header.astro';
import Range from '../../components/proto/home/Range.astro';
import CertifiedSteps from '../../components/proto/home/CertifiedSteps.astro';
import Footer from '../../components/proto/home/Footer.astro';
import HeroWorlds from '../../components/proto/r5/HeroWorlds.astro';
import HeroAnamorph from '../../components/proto/r5/HeroAnamorph.astro';
import HeroXray from '../../components/proto/r5/HeroXray.astro';
import MarkFilm from '../../components/proto/r5/MarkFilm.astro';
import ContainerFilm from '../../components/proto/r5/ContainerFilm.astro';
---
<Proto title="Round 5 (archive) · hero concepts · Pallet Euro (prototype)">
  <div class="pe">
    <Header />
    <main>
      <div class="variant" data-variant="A"><HeroWorlds /></div>
      <div class="variant" data-variant="B"><HeroAnamorph /></div>
      <div class="variant" data-variant="C"><HeroXray /></div>
      <MarkFilm />
      <Range />
      <CertifiedSteps />
      <ContainerFilm />
    </main>
    <Footer />
  </div>
  <Switcher round="Round 5" variants={[{ key: 'A', name: 'Two worlds' }, { key: 'B', name: 'In its place' }, { key: 'C', name: 'Look inside' }]} />
</Proto>

<style is:global>
  @media (min-width: 901px) {
    html:not(.scrolled) .pe .head { background: transparent; backdrop-filter: none; }
  }
</style>
