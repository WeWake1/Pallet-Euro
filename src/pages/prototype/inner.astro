---
// PROTOTYPE (throwaway) · two refined ideas for the inner pages, from the owner's round-6 answers (decisions #52):
//   A "Anatomy" (the guide page "What makes an EPAL pallet", decision #60): the part inspector rebuilt after the owner's
//     notes: vector highlight, an exploded view to play and turn, layer by layer.
//   B "Before and after" (About page): round 5's "Two worlds" redone so the pallet changes, not the room: a generic
//     worn pallet against an EPAL 1. Switch with ?variant=A|B or the arrow keys.
import Proto from '../../layouts/Proto.astro';
import Switcher from '../../components/proto/Switcher.astro';
import '../../components/proto/home/home.css';
import Header from '../../components/proto/home/Header.astro';
import Footer from '../../components/proto/home/Footer.astro';
import Anatomy from '../../components/proto/inner/Anatomy.astro';
import BeforeAfter from '../../components/proto/inner/BeforeAfter.astro';
---
<Proto title="Inner pages · anatomy and before/after · Pallet Euro (prototype)">
  <div class="pe">
    <Header />
    <main>
      <div class="variant" data-variant="A"><Anatomy /></div>
      <div class="variant" data-variant="B"><BeforeAfter /></div>
    </main>
    <Footer />
  </div>
  <Switcher round="Inner pages" variants={[{ key: 'A', name: 'Anatomy (guide page)' }, { key: 'B', name: 'Before and after (About)' }]} />
</Proto>
