---
// PROTOTYPE ARCHIVE · round 6 (23 Nov 2026): Daybreak, Neem shade, Bullet time, kept for reference. Owner's verdict
// (decisions #51): "good, but still not up to what we want"; another round asked for (round 7, /prototype/).
// The Mark and container scroll stories continue on the live prototype.
import Proto from '../../layouts/Proto.astro';
import Switcher from '../../components/proto/Switcher.astro';
import '../../components/proto/home/home.css';
import Header from '../../components/proto/home/Header.astro';
import Range from '../../components/proto/home/Range.astro';
import CertifiedSteps from '../../components/proto/home/CertifiedSteps.astro';
import Footer from '../../components/proto/home/Footer.astro';
import HeroFrames from '../../components/proto/r6/HeroFrames.astro';
import MarkFilm from '../../components/proto/r5/MarkFilm.astro';
import ContainerFilm from '../../components/proto/r5/ContainerFilm.astro';
---
<Proto title="Round 6 (archive) · hero concepts · Pallet Euro (prototype)">
  <div class="pe">
    <Header />
    <main>
      <div class="variant" data-variant="A">
        <HeroFrames variant="A" dir="/dev/r6/daybreak" count={48} start={6} mode="scrub" drift={16} fx={0.65} phoneFx={0.7}
          bg="#F3F2EF" icon="sun-horizon" fine="Move your cursor: sunrise to sunset" coarse="One pallet, sunrise to sunset"
          alt="An EPAL 1 Euro pallet in a white studio in low morning sun, its shadow stretching across the floor" />
      </div>
      <div class="variant" data-variant="B">
        <HeroFrames variant="B" dir="/dev/r6/neem" count={48} start={0} mode="loop" fx={0.5} phoneFx={0.64}
          bg="#ECE7DF" icon="leaf" fine="Move your cursor to stir the breeze" coarse="Neem shade, moving in the breeze"
          alt="An EPAL 1 Euro pallet in a sunlit lime-plaster courtyard, dappled by the moving shade of a neem tree" />
      </div>
      <div class="variant" data-variant="C">
        <HeroFrames variant="C" dir="/dev/r6/bullettime" count={61} start={30} mode="scrub" drift={12} fx={0.5} phoneFx={0.66}
          bg="#F6F4F1" icon="camera-rotate" fine="Move your cursor to circle the frozen moment" coarse="One frozen moment, from every side"
          alt="An EPAL 1 Euro pallet frozen at the instant its corner meets the floor, sawdust hanging in the air" />
      </div>
      <MarkFilm />
      <Range />
      <CertifiedSteps />
      <ContainerFilm />
    </main>
    <Footer />
  </div>
  <Switcher round="Round 6 (archive)" variants={[{ key: 'A', name: 'Daybreak' }, { key: 'B', name: 'Neem shade' }, { key: 'C', name: 'Bullet time' }]} />
</Proto>

<style is:global>
  /* Photo heroes: on computers the header floats transparent over the picture until the page scrolls. */
  @media (min-width: 901px) {
    html:not(.scrolled) .pe .head { background: transparent; backdrop-filter: none; }
  }
</style>
