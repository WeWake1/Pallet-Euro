---
// PROTOTYPE ARCHIVE · round 4 (7 Nov 2026): three photoreal hero concepts, kept for reference.
// Owner's verdict: A (Indian light) is "still good enough" (the fallback hero). B (On the headline)
// and C (White desert) disliked. See docs/prototypes/ and docs/decisions.md #21.
import Proto from '../../layouts/Proto.astro';
import Switcher from '../../components/proto/Switcher.astro';
import '../../components/proto/archive/r4/r4.css';
import Header from '../../components/proto/archive/r4/Header.astro';
import Range from '../../components/proto/archive/r4/Range.astro';
import CertifiedSteps from '../../components/proto/archive/r4/CertifiedSteps.astro';
import ContainerBand from '../../components/proto/archive/r4/ContainerBand.astro';
import Footer from '../../components/proto/archive/r4/Footer.astro';
import HeroJaali from '../../components/proto/archive/r4/heroes/HeroJaali.astro';
import HeroResting from '../../components/proto/archive/r4/heroes/HeroResting.astro';
import HeroRann from '../../components/proto/archive/r4/heroes/HeroRann.astro';
---
<Proto title="Round 4 archive · Pallet Euro (prototype)">
  <div class="pe">
    <Header />
    <main>
      <div class="variant" data-variant="A"><HeroJaali /></div>
      <div class="variant" data-variant="B"><HeroResting /></div>
      <div class="variant" data-variant="C"><HeroRann /></div>
      <Range />
      <CertifiedSteps />
      <ContainerBand />
    </main>
    <Footer />
  </div>
  <Switcher round="Round 4" variants={[{ key: 'A', name: 'Indian light' }, { key: 'B', name: 'On the headline' }, { key: 'C', name: 'White desert' }]} />
</Proto>

<style is:global>
  @media (min-width: 901px) {
    html[data-variant='A']:not(.scrolled) .pe .head,
    html[data-variant='C']:not(.scrolled) .pe .head { background: transparent; backdrop-filter: none; }
  }
</style>
