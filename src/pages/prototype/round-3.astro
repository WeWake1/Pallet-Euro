---
// PROTOTYPE ARCHIVE · round 3 (7 Nov 2026): four hero concepts, kept for reference.
// Owner's verdict: B (Stack) and D (Container) disliked as heroes, but the container idea may move
// into the "Your next container" band. A (Line) good but not a hero: reuse on a products or
// certifications page. C (Mark) good but not a hero: reuse as an Apple-style scroll section after
// the hero. The live 3D looked low quality and fake. See docs/prototypes/.
import Proto from '../../layouts/Proto.astro';
import Switcher from '../../components/proto/Switcher.astro';
import '../../components/proto/archive/r3/r3.css';
import Header from '../../components/proto/archive/r3/Header.astro';
import Range from '../../components/proto/archive/r3/Range.astro';
import CertifiedSteps from '../../components/proto/archive/r3/CertifiedSteps.astro';
import ContainerBand from '../../components/proto/archive/r3/ContainerBand.astro';
import Footer from '../../components/proto/archive/r3/Footer.astro';
import HeroLine from '../../components/proto/archive/r3/heroes/HeroLine.astro';
import HeroStack from '../../components/proto/archive/r3/heroes/HeroStack.astro';
import HeroMark from '../../components/proto/archive/r3/heroes/HeroMark.astro';
import HeroContainer from '../../components/proto/archive/r3/heroes/HeroContainer.astro';
---
<Proto title="Round 3 archive · Pallet Euro (prototype)">
  <div class="r3">
    <Header />
    <main>
      <div class="variant" data-variant="A"><HeroLine /></div>
      <div class="variant" data-variant="B"><HeroStack /></div>
      <div class="variant" data-variant="C"><HeroMark /></div>
      <div class="variant" data-variant="D"><HeroContainer /></div>
      <Range />
      <CertifiedSteps />
      <ContainerBand />
    </main>
    <Footer />
  </div>
  <Switcher round="Round 3" variants={[{ key: 'A', name: 'The Line' }, { key: 'B', name: 'The Stack' }, { key: 'C', name: 'The Mark' }, { key: 'D', name: 'The Container' }]} />
</Proto>
